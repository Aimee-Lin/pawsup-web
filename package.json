{
  "name": "pawsup-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "backend:check": "tsc -p tsconfig.edge.json",
    "backend:test": "node --experimental-strip-types --test tests/backend-*.test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/services/database.generated.ts",
    "functions:serve": "supabase functions serve health --env-file supabase/functions/.env",
    "functions:deploy": "supabase functions deploy health --use-api",
    "backend:bootstrap": "node scripts/build-backend-bootstrap.mjs"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.11.0",
    "@supabase/supabase-js": "^2.49.0",
    "vant": "^4.9.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@vitejs/plugin-vue": "^5.2.0",
    "supabase": "^3.1.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vue-tsc": "^3.3.14"
  }
}
