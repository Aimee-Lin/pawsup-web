# Copy to .env.development.local and use a separate CloudBase PG test environment.
# Empty uses local demo mode.
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=
# Enable after deploying the pawsup-v2 function to the test environment.
VITE_CLOUDBASE_V2_TOOLS=false

# Server-side only. Never prefix this key with VITE_.

TOKENHUB_API_KEY=
TOKENHUB_MODEL=deepseek-v3

# 腾讯位置服务 WebService Key，仅供服务端读取。
TMAP_WEBSERVICE_KEY=
TMAP_URI_REFERER=PawsUp
